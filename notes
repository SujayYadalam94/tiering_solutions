sudo vim /etc/default/grub
sudo update-grub

sudo awk -F"'" 'function current_path(   s,i){s=idx[0]; for(i=1;i<=depth;i++) s=s ">" idx[i]; return s} BEGIN{depth=0; idx[0]=-1} /^[[:space:]]*submenu[[:space:]]+/ {idx[depth]++; print current_path() "  [submenu] " $2; depth++; idx[depth]=-1; next} /^[[:space:]]*menuentry[[:space:]]+/ {idx[depth]++; print current_path() "  " $2; next} /^[[:space:]]*}/ && depth>0 {depth--}' /boot/grub/grub.cfg

# HybridTier
sudo grub-set-default "1>8" && sudo grub-reboot "1>8"

# TPP
sudo grub-set-default "1>14" && sudo grub-reboot "1>14"


# Nomad
sudo grub-set-default "1>16" && sudo grub-reboot "1>16"

sudo mount /dev/sda ~/tiering_solutions/logs
sudo mount /dev/sda ~/big-ann-benchmarks/data
sudo mount /dev/sdb ~/tiering_solutions/logs
sudo mount /dev/sdb ~/big-ann-benchmarks/data
sudo mount /dev/sdc ~/tiering_solutions/logs
sudo mount /dev/sdc ~/big-ann-benchmarks/data

check numastat -m
check uname -a
update run_all_measrurements
