+static bool update_max_dram_boundary_score_average(const std::vector<score_entry> &scores, float &score_average)
+{
+    const int64_t max_hugepages = max_dram_hugepages(scores);
+    if (max_hugepages <= 0 || static_cast<size_t>(max_hugepages) > scores.size())
+    {
+        return false;
+    }
+
+    const float boundary_score = scores[static_cast<size_t>(max_hugepages - 1)].page->score;
+    const float denom = get_adjusted_ewma_denom(MIGRATION_BOUNDARY_SCORE_AVERAGE_ALPHA_IDX,
+                                                max_dram_boundary_score_average_count);
+    max_dram_boundary_score_average = adjusted_ewma(max_dram_boundary_score_average, boundary_score, denom);
+    max_dram_boundary_score_average_count++;
+    score_average = max_dram_boundary_score_average;
+    return true;
+}
