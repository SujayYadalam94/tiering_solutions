+#if PRINT_TRAINING_DATA
+// Applications such as Python can terminate with exit() rather than returning
+// from main. Flush before exit starts running C++/Arrow destructors in that case
+// as well. Preserve the application's status and normal libc exit handlers.
+extern "C" [[noreturn]] void exit(int status) noexcept
+{
+    using ExitFunction = void (*)(int);
+    static const auto libc_exit = reinterpret_cast<ExitFunction>(dlsym(RTLD_NEXT, "exit"));
+    arms_kernel_shutdown();
+    if (libc_exit != nullptr)
+        libc_exit(status);
+    _exit(status);
+}
+#endif
